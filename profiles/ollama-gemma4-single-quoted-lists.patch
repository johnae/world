+
+func TestRepairGemma4ToolCallArgsSingleQuotedList(t *testing.T) {
+	args, err := repairGemma4ToolCallArgs(`{domain:['sensor']}`, "GetLiveContext", nil)
+	if err != nil {
+		t.Fatalf("repairGemma4ToolCallArgs returned error: %v", err)
+	}
+	domain, ok := args.Get("domain")
+	if !ok {
+		t.Fatalf("domain missing from repaired args: %v", args)
+	}
+	list, ok := domain.([]any)
+	if !ok || len(list) != 1 || list[0] != "sensor" {
+		t.Fatalf("domain = %#v, want [sensor]", domain)
+	}
+}
